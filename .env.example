# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scalable_api?schema=public"

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET="replace-with-at-least-32-char-random-secret-here"
JWT_EXPIRES_IN=1h

# ─── Redis ────────────────────────────────────────────────
# Local: redis://localhost:6379
# Free cloud: https://redis.io/try-free (30 MB free)
REDIS_URL=redis://localhost:6379

# ─── Email (Nodemailer) ───────────────────────────────────
# FREE dev option: https://mailtrap.io (1000 emails/month free)
# FREE prod option: Gmail SMTP (500/day free)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_pass
MAIL_FROM=noreply@yourdomain.com
